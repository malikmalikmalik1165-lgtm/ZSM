# ZAIN SUPER MART - Environment Configuration Example
# ====================================================
# Copy this file to .env and fill in the actual values

# Local Database (Sandbox PostgreSQL)
# Used for platform health checks
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase Configuration
# ----------------------
# IMPORTANT: Use ONLY the dedicated ZAIN SUPER MART Supabase project
# DO NOT use credentials from any other project
#
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-zain-supermart-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
